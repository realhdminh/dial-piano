{
  "name": "dial-piano",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "run-s lint:*",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "oxfmt src/",
    "deploy": "wrangler pages deploy dist --project-name=dial-piano"
  },
  "dependencies": {
    "@lucide/vue": "^1.29.0",
    "@tailwindcss/vite": "^4.3.3",
    "dexie": "^4.4.4",
    "pitchy": "^4.1.0",
    "tailwindcss": "^4.3.3",
    "tone": "^15.1.22",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260804.1",
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^26.1.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.77.0",
    "eslint-plugin-vue": "~10.10.0",
    "jiti": "^2.7.0",
    "npm-run-all2": "^9.0.3",
    "oxfmt": "^0.62.0",
    "oxlint": "~1.77.0",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vue-tsc": "^3.3.9",
    "wrangler": "^4.119.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}